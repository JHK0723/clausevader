# ClauseVader Backend — Environment Variables
# Copy this file to .env and fill in real values before running locally.
# Never commit .env to version control.

# PostgreSQL connection string.
# Local dev:    postgresql://user:password@localhost:5432/clausevader
# AWS Aurora:   postgresql://<username>:<password>@<aurora-endpoint>:5432/clausevader
# NeonDB:       postgresql://<username>:<password>@<neon-endpoint>.neon.tech/clausevader?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/clausevader

# OpenAI API key — must be for an active account with access to gpt-4o-mini
OPENAI_API_KEY=sk-...

# Alternative LLM providers
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=gpt-4o-mini

# S3 bucket name for storing uploaded contract files.
# Leave empty to disable S3 (files will still be processed in-memory).
AWS_S3_BUCKET_NAME=your-bucket-name

# AWS region where the S3 bucket and Lambda are deployed
AWS_REGION=us-east-1

# Comma-separated list of allowed CORS origins.
# Add your Vercel frontend URL and localhost for dev.
ALLOWED_ORIGINS=http://localhost:3000,https://clausevader.vercel.app
