# ==============================================================================
# LegalLens Backend - AWS Lambda Container Image
# Base image: AWS Lambda Python 3.11 provided by Amazon ECR Public
# Allows packaging dependencies up to 10GB with zero binary incompatibility
# ==============================================================================

FROM public.ecr.aws/lambda/python:3.11

# Copy dependency requirements
COPY requirements.txt ${LAMBDA_TASK_ROOT}

# Install dependencies into Lambda environment
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Copy backend source code into Lambda task root
COPY . ${LAMBDA_TASK_ROOT}

# Handler entrypoint wrapped with Mangum in lambda_handler.py
CMD [ "lambda_handler.handler" ]
