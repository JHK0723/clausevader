          [ "AWS/RDS", "DatabaseConnections", "DBInstanceIdentifier", "clausevader-db-instance-1", { "stat": "Maximum", "label": "DB Connections", "color": "#ff7f0e" } ],
          [ ".", "FreeableMemory", ".", ".", { "stat": "Average", "label": "Freeable Memory (Bytes)", "yAxis": "right", "color": "#9467bd" } ]
