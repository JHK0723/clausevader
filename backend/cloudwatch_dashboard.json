        "view": "timeSeries",
        "stacked": false,
        "region": "ap-south-2",
        "period": 300,
        "metrics": [
          [ "AWS/Lambda", "Duration", "FunctionName", "clausevader-backend", { "stat": "Average", "label": "Avg Duration (ms)", "color": "#2ca02c" } ],
          [ "...", { "stat": "p95", "label": "p95 Duration (ms)", "color": "#ff7f0e" } ],
          [ "...", { "stat": "Maximum", "label": "Max Duration (ms)", "color": "#d62728" } ]
        ]
      }
    },
    {
      "type": "metric",
      "x": 16,
