# ClauseVader Frontend — Environment Variables
# Copy this file to .env.local and fill in real values for local development.
# For Vercel deployment, set these in the Vercel project dashboard under
# Settings → Environment Variables.
# Never commit .env.local to version control.

# PostgreSQL connection string — same database as the backend.
# Local dev:    postgresql://user:password@localhost:5432/clausevader
# AWS Aurora:   postgresql://user:password@<aurora-endpoint>:5432/clausevader
# NeonDB:       postgresql://user:password@<neon-endpoint>.neon.tech/clausevader?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/clausevader

# Google OAuth credentials — from Google Cloud Console.
# Must match EXACTLY what is registered in the OAuth client.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Full URL of this frontend app (no trailing slash).
# Used to build the Google OAuth callback URL dynamically.
# Local dev:    http://localhost:3000
# Production:   https://clausevader.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Full URL of the FastAPI backend (no trailing slash).
# Local dev:    http://localhost:8000
# Production:   https://<api-gateway-id>.execute-api.<region>.amazonaws.com/prod
#               (your AWS API Gateway invoke URL)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
